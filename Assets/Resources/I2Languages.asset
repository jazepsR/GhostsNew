    mTerms:
    - Term: player_name_prompt
      TermType: 0
      Description: 
      Languages:
      - 35242844160
      - Enter your player name. The name can be entered only once and cannot be changed
      - "Ierakstiet J\u016Bsu sp\u0113l\u0113t\u0101ja v\u0101rdu. V\u0101rdu var
        ierakst\u012Bt tikai vienu reizi un to nevar\u0113s izmain\u012Bt"
      - "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043C\u044F \u0438\u0433\u0440\u043E\u043A\u0430.
        \u0418\u043C\u044F \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
        \u0432\u0432\u0435\u0434\u0435\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
        \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
        \u0431\u044B\u0442\u044C \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u043E"
      Flags: 00000000
      Languages_Touch: []
